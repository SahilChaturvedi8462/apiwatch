# =============================================================================
# APIWatch Environment Variables Template
# Copy this file to .env and adjust values for your local environment.
# Never commit the .env file or real credentials into version control!
# =============================================================================

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apiwatch_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Authentication
# Minimum 256-bit (32 bytes) secret for HS256 algorithm
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Scheduler Configuration (Interval in milliseconds, 60000 = 1 minute)
SCHEDULER_INTERVAL_MS=60000

# SMTP Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=no-reply@apiwatch.com
MAIL_ENABLED=false
